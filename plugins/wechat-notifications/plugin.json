{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "wechat-notifications",
  "version": "0.1.0",
  "description": "Read and search locally authorized WeChat notification snippets on macOS.",
  "author": { "name": "Orbit contributors" },
  "homepage": "https://github.com/scfdds/orbit-personal-agent/tree/main/plugins/wechat-notifications",
  "repository": "https://github.com/scfdds/orbit-personal-agent",
  "keywords": ["wechat", "notifications", "macos", "context", "mcp"],
  "extensions": {
    "com.openai": {
      "requires_local_executor": true,
      "interface": {
        "displayName": "微信通知",
        "shortDescription": "查询本机已允许读取的微信通知片段",
        "developerName": "Orbit contributors",
        "category": "Productivity",
        "defaultPrompt": [
          "看看最近微信通知里有哪些需要我留意的变化，并引用消息来源。"
        ]
      }
    }
  }
}
